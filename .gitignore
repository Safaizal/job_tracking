# --- BACKEND (Python/FastAPI) ---
# Virtual environments (Never push these!)
backend/venv/
backend/env/
backend/.venv/

# Python cache
backend/__pycache__/
backend/*.pyc
backend/*.pyo

# SECRETS (CRITICAL: DO NOT PUSH THESE)
# Signs every session cookie
backend/.session_secret
backend/credentials.json
backend/.env

# Per-user Google tokens (one file per signed-in account, inbox access)
backend/tokens/

# Leftovers from the old single-user, database-backed version
backend/token.json
backend/jobs.db
backend/oauth_state.json

# --- FRONTEND (Node/React) ---
# Dependencies (Never push these!)
frontend/node_modules/

# Build output
frontend/dist/
frontend/build/

# Environment variables
frontend/.env.local
frontend/.env

# --- EDITOR & OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
